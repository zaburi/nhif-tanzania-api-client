{
  "name": "nhif-tanzania-api-client",
  "version": "0.1.0",
  "description": "TypeScript client for NHIF Tanzania member verification, NIDA lookup, and authorization number flow for HMIS and clinic systems.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "art",
    "examples",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "nhif",
    "tanzania",
    "api",
    "hmis",
    "nida",
    "verification",
    "authorization",
    "nextjs",
    "healthcare",
    "insurance"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  }
}
